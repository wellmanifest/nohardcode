{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/detection-rule.schema.json",
  "title": "Wellmanifest Detection Rule",
  "description": "Schema for specific hardcoded pattern detection rules.",
  "type": "object",
  "required": ["rule_id", "category", "target_replacement", "severity", "matcher"],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^NOHARDCODE-[0-9]{3}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "natural_language_keywords",
        "screen_coordinates",
        "ui_labels",
        "business_logic_branching",
        "secrets_and_credentials",
        "network_endpoints_and_ports",
        "log_and_error_strings",
        "pii_and_fixtures",
        "filesystem_paths",
        "code_duplication"
      ]
    },
    "description": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["error", "warning", "info"]
    },
    "target_replacement": {
      "type": "string",
      "description": "Recommended technology replacement (e.g. LLM, YOLO, Tesseract OCR, JEV, wellmanifest/secrets, wellmanifest/env-dsl)"
    },
    "wellmanifest_standard": {
      "type": "string",
      "description": "Referenced wellmanifest companion standard (if applicable)"
    },
    "matcher": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["ast", "regex", "heuristic", "composite"] },
        "patterns": { "type": "array", "items": { "type": "string" } },
        "ast_node_types": { "type": "array", "items": { "type": "string" } },
        "threshold": { "type": ["integer", "number"] }
      },
      "required": ["kind"]
    }
  },
  "additionalProperties": false
}
