{
  "$schema": "https://raw.githubusercontent.com/wellmanifest/dsl/b7d0595c95e5abbb48ebfdbdae0bc6d43c6f82f4/schemas/dsl-manifest.schema.json",
  "schema": "wellmanifest.dsl/manifest/v1",
  "id": "wellmanifest.nohardcode",
  "name": "Wellmanifest No-Hardcode Standard",
  "version": "0.1.0-dev",
  "status": "experimental",
  "purpose": "Normative standard for identifying, classifying, and eliminating hardcoded data, brittle heuristics, static coordinates, and rigid keyword lists by replacing them with proven dynamic technologies (JEV, LLM, Tesseract OCR, YOLO, Vaults, and env-dsl)",
  "domain": "code-quality-and-dynamic-adaptation",
  "owners": [
    {
      "kind": "repository",
      "id": "github:wellmanifest/nohardcode",
      "responsibilities": [
        "semantics",
        "taxonomy",
        "remediation-patterns",
        "conformance",
        "cross-standard-integration"
      ]
    }
  ],
  "source": {
    "repository": "https://github.com/wellmanifest/nohardcode",
    "path": "schemas/nohardcode-policy.schema.json",
    "declaredVersion": "1",
    "canonical": "json-ast",
    "mediaType": "application/schema+json",
    "selectors": []
  },
  "ownedPaths": [
    "dsl-manifest.json",
    "nohardcode-policy.json",
    "schemas/**",
    "standard/**",
    "docs/**",
    "README.md",
    "AGENTS.md",
    "GEMINI.md",
    "VERSION",
    "CHANGELOG.md",
    ".gitignore"
  ],
  "artifacts": [
    {
      "id": "schema:nohardcode-policy",
      "path": "schemas/nohardcode-policy.schema.json",
      "mediaType": "application/schema+json",
      "purpose": "JSON Schema for repository-level unhardcoding policies, thresholds, and dynamic technology mappings"
    },
    {
      "id": "schema:detection-rule",
      "path": "schemas/detection-rule.schema.json",
      "mediaType": "application/schema+json",
      "purpose": "JSON Schema for AST/regex detection rules identifying hardcoded smells"
    },
    {
      "id": "doc:taxonomy-and-use-cases",
      "path": "docs/TAXONOMY_AND_USE_CASES.md",
      "mediaType": "text/markdown",
      "purpose": "Comprehensive catalog of hardcoded anti-patterns and concrete remediation patterns using LLM, JEV, Tesseract OCR, YOLO, etc."
    },
    {
      "id": "doc:specification",
      "path": "docs/SPEC.md",
      "mediaType": "text/markdown",
      "purpose": "Normative specifications and compliance levels (NOHARDCODE-001 through NOHARDCODE-010)"
    },
    {
      "id": "doc:architecture",
      "path": "docs/ARCHITECTURE.md",
      "mediaType": "text/markdown",
      "purpose": "System boundaries, ecosystem interoperability, and adoption matrix with wellmanifest/*"
    },
    {
      "id": "doc:adoption-guide",
      "path": "docs/ADOPTION_GUIDE.md",
      "mediaType": "text/markdown",
      "purpose": "Step-by-step repository migration and automated refactoring guide"
    }
  ],
  "dependencies": {
    "wellmanifest/secrets": ">=0.1.0",
    "wellmanifest/env-dsl": ">=0.1.0",
    "wellmanifest/logs": ">=0.1.0",
    "wellmanifest/reuse": ">=0.1.0",
    "wellmanifest/anonym": ">=0.1.0"
  }
}
